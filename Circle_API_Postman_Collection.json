{
  "info": {
    "name": "Circle API",
    "_postman_id": "circle-api-collection",
    "description": "Postman documentation collection for the Circle social media API. Set `base_url`, run Auth > Sign Up, then Auth > Obtain JWT Token. The token requests automatically save `access_token` and `refresh_token` collection variables when successful.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response has a valid HTTP status\", function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 401, 403, 404]);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "User registration and JWT authentication endpoints.",
      "item": [
        {
          "name": "Sign Up",
          "description": "Create a user account. Password must satisfy the Django password validators configured in the project.",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"StrongPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/signup/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          }
        },
        {
          "name": "Obtain JWT Token",
          "description": "Exchange username and password for Simple JWT access and refresh tokens. Successful responses are saved into collection variables.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set(\"access_token\", json.access);",
                  "  pm.collectionVariables.set(\"refresh_token\", json.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"StrongPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token"
              ]
            }
          }
        },
        {
          "name": "Refresh JWT Token",
          "description": "Use a refresh token to get a new access token. Successful responses update `access_token`.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"access_token\", pm.response.json().access);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                "refresh"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "description": "Post feed, post detail, and authenticated post management. Visibility values are `public` or `private`.",
      "item": [
        {
          "name": "List Posts",
          "description": "List all posts. Supports pagination, username filtering, post text filtering, search, and ordering by `created_at`.",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/?page=1&username=&post__icontains=&search=&ordering=-created_at",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number for DRF PageNumberPagination."
                },
                {
                  "key": "username",
                  "value": "",
                  "description": "Case-insensitive username filter."
                },
                {
                  "key": "post__icontains",
                  "value": "",
                  "description": "Case-insensitive filter against post text."
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search by username or post text."
                },
                {
                  "key": "ordering",
                  "value": "-created_at",
                  "description": "Use `created_at` or `-created_at`."
                }
              ]
            }
          }
        },
        {
          "name": "Create Post",
          "description": "Create a post for the authenticated user. `image` is optional.",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "post",
                  "value": "My post content",
                  "type": "text",
                  "description": "Required. Up to 1000 characters."
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Optional image upload."
                },
                {
                  "key": "visibility",
                  "value": "public",
                  "type": "text",
                  "description": "`public` or `private`."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/posts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "Get Post",
          "description": "Retrieve one post by UUID.",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
