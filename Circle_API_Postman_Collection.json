              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}"
              ]
            }
          }
        },
        {
          "name": "Update Post",
          "description": "Replace a post. Only the owner can update.",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "post",
                  "value": "Updated post content",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "visibility",
                  "value": "public",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}"
              ]
            }
