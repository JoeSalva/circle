# Django
DJANGO_SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: either point DATABASE_URL at a Postgres instance…
# DATABASE_URL=postgres://user:password@host:5432/circle_db
# …or set USE_SQLITE=True to run on a local file database.
USE_SQLITE=True

# Redis (optional): cache + Celery broker. Without it the app degrades to an
# in-memory cache and runs Celery tasks eagerly.
# REDIS_URL=redis://127.0.0.1:6379/1

# Optional superuser + demo data created at container start.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# SEED_DEMO=1

# Profiling (dev only)
# ENABLE_SILK=True
